{
    "name": "mleczakm/radzymin.mleczki.pl",
    "description": "Serwis do bezpiecznego zbierania podpisów pod petycjami mieszkańców Radzymina.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-swoole": "*",
        "ext-pdo_sqlite": "*",
        "ext-json": "*",
        "psr/log": "^3.0",
        "symfony/mailer": "^7.1",
        "dompdf/dompdf": "^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {},
        "platform": {
            "php": "8.5.99"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src bin config -name '*.php' -print0 | xargs -0 -n1 php -l"
    }
}
