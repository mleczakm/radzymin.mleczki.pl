{
    "name": "mleczakm/radzymin.mleczki.pl",
    "description": "Serwis do bezpiecznego zbierania podpisów pod petycjami mieszkańców Radzymina.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-pdo_sqlite": "*",
        "ext-swoole": "*",
        "league/commonmark": "^2.10",
        "psr/log": "^3.0",
        "symfony/mailer": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "carthage-software/mago": "^1.49",
        "phpunit/phpunit": "^13.3",
        "swoole/ide-helper": "^6.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {},
        "platform": {
            "php": "8.5.99"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src bin config -name '*.php' -print0 | xargs -0 -n1 php -l",
        "analyze": "mago analyze",
        "lint:style": "mago lint",
        "check": [
            "@lint",
            "@analyze",
            "@lint:style",
            "@test"
        ]
    }
}
