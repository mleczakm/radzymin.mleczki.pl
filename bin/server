#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Action\Admin\DashboardAction;
use App\Action\Admin\ExportCsvAction;
use App\Action\Admin\PaperSignatureFormAction;
use App\Action\Admin\PaperSignatureStoreAction;
use App\Action\ConfirmAction;
use App\Action\HealthAction;
use App\Action\HomeAction;
use App\Action\PetitionPrintAction;
use App\Action\PetitionShowAction;
use App\Action\PetitionSignAction;
use App\Action\PrivacyAction;
use App\Action\TopicShowAction;
use App\Http\Router;
use App\Runtime\WorkerServices;
use App\Security\ProductionGuard;
use App\Security\RateLimiter;
use App\Security\SignatureFormValidator;
use App\Server\Factory;
use App\Task\Handler as TaskHandler;
use App\View\Renderer;

require __DIR__ . '/../config/bootstrap.php';

$environment = env('APP_ENV', 'prod');
ProductionGuard::assertSafe($environment, env('APP_SECRET', ''), env('ADMIN_PASSWORD_HASH', ''));

$server = Factory::create();

// Shared-memory table must be created before the server forks its workers.
$rateLimitTable = RateLimiter::createTable();

$services = new WorkerServices($rateLimitTable);
// Available in every template: organizer contact details (public, tiny) and the site's base URL.
$view = new Renderer(dirname(__DIR__) . '/templates', [
    'organizer' => require dirname(__DIR__) . '/config/organizer.php',
    'baseUrl' => rtrim(env('BASE_URL', 'https://radzymin.mleczki.pl'), '/'),
]);
$validator = new SignatureFormValidator();

$server->on('WorkerStart', function () use ($services): void {
    $services->boot();
});

$router = new Router();
$router->get('/', new HomeAction($services, $view));
$router->get('/zdrowie', new HealthAction());
$router->get('/polityka-prywatnosci', new PrivacyAction($view));
$router->get('/sprawy/{slug}', new TopicShowAction($services, $view));
$router->get('/petycja/{slug}', new PetitionShowAction($services, $view));
$router->post('/petycja/{slug}/podpisz', new PetitionSignAction($server, $services, $view, $validator));
$router->get('/petycja/{slug}/lista', new PetitionPrintAction($services, $view));
$router->get('/potwierdz/{token}', new ConfirmAction($services, $view));

$router->get('/admin', new DashboardAction($services, $view));
$router->get('/admin/petycje/{slug}/eksport.csv', new ExportCsvAction($services));
$router->get('/admin/petycje/{slug}/papier', new PaperSignatureFormAction($services, $view));
$router->post('/admin/petycje/{slug}/papier', new PaperSignatureStoreAction($services, $view));

$server->on('Request', function ($request, $response) use ($router): void {
    $router->dispatch($request, $response);
});

$taskHandler = new TaskHandler($services);
$server->on('Task', function ($server, $task) use ($taskHandler): void {
    $taskHandler->handle($server, $task);
});
$server->on('Finish', function (): void {
    // No-op: task results aren't consumed by the HTTP worker.
});

$server->start();
