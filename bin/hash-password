#!/usr/bin/env php
<?php

declare(strict_types=1);

// Generates a password hash for ADMIN_PASSWORD_HASH.
// Usage: bin/hash-password "your-admin-password"

if ($argc < 2) {
    fwrite(STDERR, "Usage: bin/hash-password \"your-admin-password\"\n");
    exit(1);
}

echo password_hash($argv[1], PASSWORD_DEFAULT), PHP_EOL;
