# Local development defaults. Committed on purpose so `docker compose up` works out of the box.
#
# NOTHING HERE IS SECRET — this repository is public. Production values come from the DOTENV
# GitHub secret (see README), and the server refuses to start in production with the insecure
# dev values below (APP_SECRET "dev-insecure-…", admin password "admin").

APP_ENV=dev
APP_DEBUG=1

# Signs the anti-bot timing token and hashes IPs for rate limiting.
# Production: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=dev-insecure-do-not-use-in-production

DB_PATH=./var/data.sqlite
BASE_URL=http://localhost:8080

# Local development: Mailpit (see compose.yaml) catches all outgoing mail at http://localhost:8026
MAILER_DSN=smtp://mailpit:1025
MAIL_FROM=radzymin.mleczki@gmail.com

# Production: Gmail account created for this site (app password, not the account password).
# The @ in the Gmail address must be URL-encoded as %40.
# MAILER_DSN=smtp://radzymin.mleczki%40gmail.com:APP_PASSWORD@smtp.gmail.com:587

# One coroutine worker is plenty for this site and keeps memory low (~8 MB per extra process).
WORKER_NUM=1

# Admin panel (HTTP Basic Auth) — dev login: admin / admin.
# Production hash: bin/hash-password "your-password"
# Keep the single quotes: docker compose would otherwise interpolate the "$" characters of the hash.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH='$2y$12$4WVQrXeDabPT.SHjPXrtDuxHeBhYby7f6DlpsjKTyuoywcjh2d34u'

# RODO / privacy policy details
ORGANIZER_NAME=Michał Mleczko
ORGANIZER_ADDRESS=zamieszkały w Radzyminie
ORGANIZER_EMAIL=kontakt@radzymin.mleczki.pl
# Optional: shown next to the e-mail in the contact section (e.g. +48 600 000 000)
# ORGANIZER_PHONE=
# Formspree contact form. The organizer config defaults to the production form ID, so a local
# test submission sends a real message to the organizer. Override only to test a different form.
# CONTACT_FORM_ENDPOINT=https://formspree.io/f/xwlppzoj
