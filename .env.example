# Copy to .env for local development (docker-compose reads it automatically).

APP_ENV=dev
APP_DEBUG=1

# Random secret used to sign the anti-bot timing token and hash IPs for rate limiting.
# Generate one with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=change-me-to-a-random-64-char-hex-string

DB_PATH=./var/data.sqlite
BASE_URL=http://localhost:8080

# Local development: Mailpit (see compose.yaml), catches all outgoing mail at http://localhost:8025
MAILER_DSN=smtp://mailpit:1025
MAIL_FROM=radzymin.mleczki@gmail.com

# Production: Gmail account created for this site (app password, not the account password).
# The @ in the Gmail address must be URL-encoded as %40.
# MAILER_DSN=smtp://radzymin.mleczki%40gmail.com:APP_PASSWORD@smtp.gmail.com:587

WORKER_NUM=2
TASK_WORKER_NUM=2

# Admin panel (HTTP Basic Auth). Generate the hash with: bin/hash-password "your-password"
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=change-me

# RODO / privacy policy details
ORGANIZER_NAME=TODO: imię i nazwisko / nazwa organizatora petycji
ORGANIZER_ADDRESS=TODO: adres korespondencyjny organizatora
ORGANIZER_EMAIL=radzymin.mleczki@gmail.com
